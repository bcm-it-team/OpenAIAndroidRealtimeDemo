<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 메인 컨텐츠 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 自定义的波动视图 -->
        <com.navbot.aihelper.CircleWaveView
        android:id="@+id/circle_wave_view"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_gravity="center"
        android:layout_marginTop="60dp" />

    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/ic_close"
        android:visibility="gone" />

    <!-- 질문 텍스트 표시 -->
    <TextView
        android:id="@+id/ask_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="20dp"
        android:text="질문이 여기에 표시됩니다"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="10dp" />

    <!-- 답변 텍스트 표시 -->
    <TextView
        android:id="@+id/answer_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="20dp"
        android:text="답변이 여기에 표시됩니다"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="10dp" />

    <!-- WebSocket 연결/해제 버튼 -->
    <Button
        android:id="@+id/btn_websocket_toggle"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="#4CAF50"
        android:text="🔌 연결하기"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <Button
        android:id="@+id/btn_clear_and_reset"
        android:layout_width="200dp"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="#F08585"
        android:text="clear and reset"
        android:textSize="10sp"/>

    <!-- 텍스트 전송 버튼 -->
    <Button
        android:id="@+id/btnSendText"
        android:layout_width="200dp"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="#4CAF50"
        android:text="Send Text"
        android:textColor="@android:color/white"
        android:textSize="12sp"/>

        <!-- 내 음성 재생 버튼 -->
        <Button
            android:id="@+id/playmys"
            android:layout_width="200dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:background="#FF9800"
            android:text="Play My Voice"
            android:textColor="@android:color/white"
            android:textSize="12sp"/>

    </LinearLayout>

    <!-- 스피커/핸드셋 전환 버튼 (오른쪽 상단) -->
    <Button
        android:id="@+id/btn_speaker_toggle"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="#4CAF50"
        android:text="🔊"
        android:textSize="24sp"
        android:textColor="@android:color/white"/>

</FrameLayout>
